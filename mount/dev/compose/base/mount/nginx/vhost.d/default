location ^~ /proxy/ {
    # Resolve the optional gateway at request time. A literal upstream makes
    # nginx-proxy fail its config reload when the gateway profile is disabled.
    set $traefik_upstream traefik;
    proxy_pass http://$traefik_upstream:80;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
}
