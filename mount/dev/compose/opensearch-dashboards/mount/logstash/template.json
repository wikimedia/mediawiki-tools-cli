{
  "index_patterns": ["mwcli-logs-*"],
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "@timestamp": {"type": "date"},
      "message": {"type": "text"},
      "path": {"type": "keyword"},
      "service": {"type": "keyword"},
      "event": {"type": "object", "enabled": false}
    }
  }
}
