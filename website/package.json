{
  "name": "a-wikimedia-cli-manual",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build && node scripts/check-links.mjs",
    "check": "npm run generate && node --test scripts/*.test.mjs && astro check",
    "preview": "astro preview --host 127.0.0.1",
    "retirement-plan": "npm run generate && node scripts/retirement-plan.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3"
  }
}
