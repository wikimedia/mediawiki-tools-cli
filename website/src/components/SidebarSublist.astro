---
import { Badge } from '@astrojs/starlight/components';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type SidebarEntry = StarlightRouteData['sidebar'][number];
interface Props { sublist: SidebarEntry[]; nested?: boolean }
const { sublist, nested = false } = Astro.props;
---

<ul class:list={{ 'top-level': !nested }}>
  {sublist.map((entry) => (
    <li>
      {entry.type === 'link' ? (
        <a {...entry.attrs} href={entry.href} aria-current={entry.isCurrent ? 'page' : undefined} class:list={[{ large: !nested }, entry.attrs.class]}>
          <span>{entry.label}</span>
          {entry.badge && <Badge {...entry.badge} />}
        </a>
      ) : (
        <>
          <span class="group-name">{entry.label}{entry.badge && <Badge {...entry.badge} />}</span>
          <Astro.self sublist={entry.entries} nested />
        </>
      )}
    </li>
  ))}
</ul>

<style>
  ul { --item-padding: 0.5rem; list-style: none; padding: 0; }
  li { overflow-wrap: anywhere; }
  ul ul li { margin-inline-start: var(--item-padding); padding-inline-start: var(--item-padding); border-inline-start: 1px solid var(--sl-color-hairline-light); }
  .top-level > li + li { margin-top: 0.75rem; }
  a { display: block; border-radius: 0.25rem; padding: 0.3em var(--item-padding); text-decoration: none; color: var(--sl-color-gray-2); line-height: 1.4; }
  a:hover, a:focus { color: var(--sl-color-white); }
  .large, .group-name { font-weight: 600; color: var(--sl-color-white); }
  .large { font-size: var(--sl-text-lg); }
  .group-name { display: block; padding: 0.3em var(--item-padding); }
  [data-active-branch]:not([aria-current]) { color: var(--sl-color-text-accent); font-weight: 600; }
  [aria-current='page'], [aria-current='page']:hover, [aria-current='page']:focus { font-weight: 600; color: var(--sl-color-text-invert); background: var(--sl-color-text-accent); }
  a > :not(:last-child), .group-name > :not(:last-child) { margin-inline-end: 0.25em; }
  @media (min-width: 50rem) {
    .top-level > li + li { margin-top: 0.5rem; }
    .large { font-size: var(--sl-text-base); }
    a { font-size: var(--sl-text-sm); }
  }
</style>
